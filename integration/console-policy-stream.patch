new file mode 100644
index 0000000..0855e28
--- /dev/null
+++ b/tests/test_policy_stream.py
@@ -0,0 +1,136 @@
+"""Exercise the policy stream against a simulated servo plant, never serial hardware."""
+
+import struct
+import time
+import unittest
+from unittest.mock import patch
+
+from nexarm import kinematics
+from nexarm.server import Controller
+from test_motion import Plant
+
+
+class PolicyStreamTests(unittest.TestCase):
+    start = [2044, 2210, 1829, 1592, 2053, 1806]
+
+    def setup_controller(self, stalled=None):
+        controller = Controller(None)
+        controller.port = "test"
+        controller.bridge_started = True
+        controller.bridge_ready = True
+        controller.torque[:] = [True] * 6
+        controller.voltage = 12
+        now = time.monotonic()
+        controller.owner = "policy-test"
+        controller.lease_end = now + 10
+        plant = Plant(self.start, stalled)
+        plant.update(controller, now)
+        return controller, plant, now
+
+    def send(self, controller, goal, now, backend="bridge"):
+        with patch("nexarm.server.time.monotonic", return_value=now):
+            controller.act("policy-step", "policy-test", {
+                "angles": [kinematics.angle(i, p) for i, p in enumerate(goal)], "backend": backend})
+
+    def test_targets_can_update_before_previous_target_settles(self):
+        controller, plant, now = self.setup_controller()
+        for index in range(1, 9):
+            tick = now + index * 0.085
+            plant.update(controller, tick)
+            goal = plant.positions.copy()
+            goal[2] += 20
+            self.send(controller, goal, tick)
+            controller.tick_policy(plant, tick)
+        self.assertIsNotNone(controller.policy_stream)
+        self.assertIsNone(controller.motion)
+        self.assertGreater(plant.positions[2], self.start[2] + 20)
+        self.assertGreater(len(plant.sent), 5)
+
+    def test_stalled_axis_stops_even_when_new_targets_keep_arriving(self):
+        controller, plant, now = self.setup_controller(stalled=2)
+        for index in range(1, 30):
+            tick = now + index * 0.085
+            plant.update(controller, tick)
+            goal = plant.positions.copy()
+            goal[2] += 20
+            self.send(controller, goal, tick)
+            controller.tick_policy(plant, tick)
+            if controller.policy_stream is None:
+                break
+        self.assertIsNone(controller.policy_stream)
+        self.assertIsNone(controller.owner)
+        self.assertIn("J3 编码器无进展", controller.result)
+
+    def test_interrupted_policy_stream_stops_without_next_request(self):
+        controller, plant, now = self.setup_controller()
+        goal = self.start.copy()
+        goal[2] += 20
+        self.send(controller, goal, now)
+        controller.tick_policy(plant, now + 0.81)
+        self.assertIsNone(controller.policy_stream)
+        self.assertIn("目标流中断", controller.result)
+
+    def test_outside_limit_retreat_does_not_reverse_after_overshoot(self):
+        controller, plant, now = self.setup_controller()
+        plant.positions[1] = 3050
+        plant.update(controller, now + 0.01)
+        goal = plant.positions.copy()
+        goal[1] = 3030
+        self.send(controller, goal, now + 0.01)
+        # A fresh encoder sample passes the retreat goal while still outside the soft bound.
+        plant.positions[1] = 3027
+        plant.now = now + 0.10
+        controller.update_feedback([(p, 0) for p in plant.positions], now + 0.10)
+        controller.tick_policy(plant, now + 0.10)
+        self.assertIsNotNone(controller.policy_stream)
+        self.assertEqual(controller.policy_stream["goal"][1], 3027)
+        self.assertEqual(plant.sent[-1][1][1], 3027)
+
+    def test_normal_sync_protocol_keeps_normal_mode_and_records_actual_commands(self):
+        controller, _, now = self.setup_controller()
+        controller.bridge_started = None
+        controller.bridge_ready = False
+        controller.last_voltage = now
+
+        class NormalPlant(Plant):
+            def __init__(self, positions):
+                super().__init__(positions)
+                self.codes = []
+
+            def write(self, frame):
+                self.codes.append(frame[4])
+                if frame[4] == 70:
+                    self.command = list(struct.unpack("<6h", frame[5:17]))
+                    self.sent.append((self.now, self.command))
+                    self.duration = struct.unpack("<H", frame[17:19])[0]
+
+        plant = NormalPlant(self.start)
+        plant.update(controller, now)
+        goal = self.start.copy()
+        goal[2] += 20
+        self.send(controller, goal, now, backend="normal_sync")
+        controller.tick_policy(plant, now)
+        self.assertNotIn(68, plant.codes)
+        self.assertEqual(plant.command, goal)
+        self.assertEqual(plant.duration, 400)
+        self.assertEqual(controller.commands[-1][1], tuple(goal))
+        controller.hold(now)
+        self.assertIsNone(controller.policy_stream)
+        self.assertEqual(controller.pending[0][0][4], 70)
+        self.assertEqual(list(struct.unpack("<6h", controller.pending[0][0][5:17])), self.start)
+
+    def test_normal_protocol_rejects_existing_bridge_mode(self):
+        controller, plant, now = self.setup_controller()
+        with self.assertRaisesRegex(ValueError, "常规协议"):
+            self.send(controller, self.start, now, backend="normal_sync")
+        self.assertIsNone(controller.policy_stream)
+        self.assertFalse(plant.sent)
+
+    def test_far_target_is_rejected_before_motion(self):
+        controller, plant, now = self.setup_controller()
+        goal = self.start.copy()
+        goal[2] += 80
+        with self.assertRaisesRegex(ValueError, "55"):
+            self.send(controller, goal, now)
+        self.assertIsNone(controller.policy_stream)
+        self.assertFalse(plant.sent)
